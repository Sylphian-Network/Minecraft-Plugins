root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.bat]
end_of_line = crlf

# Trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Opt-in; each rewrites existing files on next save:
#   insert_final_newline = true      6 of 150 sampled files lack one
#   trim_trailing_whitespace = true  63 of 200 sampled .java files have some
