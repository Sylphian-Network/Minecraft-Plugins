# Normalise every text file to LF in the repository and in the working tree.
# eol=lf overrides core.autocrlf, so this holds regardless of local git config.
* text=auto eol=lf

# Windows launchers must keep CRLF to run correctly under cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# CI runs ./gradlew under sh; CRLF breaks the shebang.
gradlew text eol=lf

# Binary: no eol conversion, no textual diff, no merge attempt.
*.jar binary
*.zip binary
*.png binary
*.ogg binary
*.nbt binary
